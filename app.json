{
  "name": "Chesa Auto",
  "description": "Telegram Chesa chess webapp auto-play bot",
  "repository": "https://github.com/oyevipthoma88/Chesa_Auto",
  "keywords": [
    "telegram",
    "bot",
    "chess",
    "auto-play",
    "pyrogram",
    "heroku"
  ],
  "env": {
    "API_ID": {
      "description": "Telegram API ID from my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "Telegram API Hash from my.telegram.org",
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Bot token from @BotFather",
      "required": true
    },
    "OWNER_ID": {
      "description": "Numeric Telegram owner ID",
      "required": true
    },
    "OWNER_USERNAME": {
      "description": "Owner username without @",
      "required": false
    },
    "MONGO_URI": {
      "description": "MongoDB Atlas connection string",
      "required": true
    },
    "MONGO_DB": {
      "description": "MongoDB database name",
      "value": "chesa_auto",
      "required": false
    },
    "LOG_CHANNEL": {
      "description": "Numeric Telegram log channel ID",
      "required": false
    },
    "UPDATE_CHANNEL": {
      "description": "Update channel username with @",
      "required": false
    },
    "UPDATE_CHANNEL_LINK": {
      "description": "Update channel invite URL",
      "required": false
    },
    "GAME_BOT_USERNAME": {
      "description": "Game bot username",
      "value": "GameFactoryBot",
      "required": false
    },
    "HEROKU_APP_NAME": {
      "description": "Heroku app name",
      "required": false
    },
    "AUTOPLAY_DEPTH": {
      "description": "Engine depth: 2, 3 or 4",
      "value": "3",
      "required": false
    },
    "WEBAPP_URL": {
      "description": "Full https URL of the webapp or GameFactory game link",
      "required": false
    }
  },
  "formation": {
    "web": {
      "quantity": 1,
      "size": "eco"
    }
  },
  "buildpacks": [
    {
      "url": "heroku-community/apt"
    },
    {
      "url": "heroku/python"
    }
  ],
  "stack": "heroku-24"
}
