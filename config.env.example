# ─── Telegram API (get from https://my.telegram.org) ───
API_ID=
API_HASH=

# ─── Your bot token from @BotFather ───
BOT_TOKEN=

# ─── Owner info ───
OWNER_ID=
OWNER_USERNAME=

# ─── MongoDB (MongoDB Atlas free tier recommended) ───
MONGO_URI=
MONGO_DB=chesa_auto

# ─── Logging / channels ───
LOG_CHANNEL=
UPDATE_CHANNEL=@YourUpdateChannel
UPDATE_CHANNEL_LINK=https://t.me/YourUpdateChannel

# ─── User session (created via /login, stored in MongoDB) ───
USER_SESSION_NAME=chesa_user

# ─── Game config ───
GAME_BOT_USERNAME=GameFactoryBot
GAME_NAME=Chesa

# ─── Heroku / server ───
PORT=8080
HEROKU_APP_NAME=
# Full https URL of the webapp (preferred over HEROKU_APP_NAME)
WEBAPP_URL=
AUTOPLAY_DEPTH=3
AUTOPLAY_ENABLED=true

# ─── Logging level ───
LOG_LEVEL=INFO
